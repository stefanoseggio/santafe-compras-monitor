{
  "name": "santafe-compras-monitor",
  "version": "1.0.0",
  "type": "module",
  "description": "Santa Fe Compras Monitor: extracts public tenders (licitaciones, contrataciones) from the Province of Santa Fe, Argentina's official procurement JSON API, with full detail per process - dates, budget, organism, rubros and direct document links.",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "apify": "^3.7.0",
    "cheerio": "1.0.0-rc.12"
  },
  "devDependencies": {
    "@apify/eslint-config": "^2.0.0",
    "@apify/tsconfig": "^0.2.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.29.0",
    "eslint-config-prettier": "^10.1.5",
    "globals": "^17.0.0",
    "prettier": "^3.5.3",
    "tsx": "^4.20.3",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.58.0",
    "vitest": "^4.1.0"
  },
  "scripts": {
    "start": "npm run start:dev",
    "start:prod": "node dist/main.js",
    "start:dev": "tsx src/main.ts",
    "build": "tsc",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run"
  },
  "author": "Stefano",
  "license": "ISC"
}
